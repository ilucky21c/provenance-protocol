{
  "name": "provenance-protocol",
  "version": "0.1.5",
  "description": "The Provenance Protocol \u2014 open standard for AI agent identity \u2014 and its reference SDK",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "provenance": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./keygen": {
      "types": "./src/keygen.d.ts",
      "import": "./src/keygen.js"
    }
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "src/keygen.js",
    "src/keygen.d.ts",
    "src/cli.js",
    "README.md",
    "SPEC.md",
    "schema/provenance-0.1.json",
    "test-vectors/"
  ],
  "keywords": [
    "ai-agent",
    "agent-identity",
    "provenance",
    "trust",
    "llm",
    "verification"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilucky21c/provenance-protocol"
  },
  "homepage": "https://getprovenance.dev",
  "engines": {
    "node": ">=14.0.0"
  }
}
